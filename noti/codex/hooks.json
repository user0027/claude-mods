{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "noti",
            "command": "node \"$PLUGIN_ROOT/codex/noti.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/codex/noti.mjs\"",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "statusMessage": "noti",
            "command": "node \"$PLUGIN_ROOT/codex/noti.mjs\"",
            "commandWindows": "node \"$env:PLUGIN_ROOT/codex/noti.mjs\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
